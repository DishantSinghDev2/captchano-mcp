{
  "name": "captchano-mcp",
  "version": "1.0.0",
  "description": "Official CaptchaNo MCP server: let AI agents solve reCAPTCHA v2/v3/Enterprise, Cloudflare Turnstile, DataDome and image captchas through the CaptchaNo API.",
  "mcpName": "io.github.DishantSinghDev2/captchano-mcp",
  "type": "module",
  "bin": {
    "captchano-mcp": "dist/index.js"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "server.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/index.js",
    "build:test": "rm -rf build-test && tsc -p tsconfig.test.json",
    "test": "npm run build:test && CAPTCHANO_LOG_LEVEL=silent node --test build-test/test/",
    "e2e": "npm run build && node scripts/e2e.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "captcha",
    "captcha-solver",
    "recaptcha",
    "turnstile",
    "datadome",
    "ai-agents",
    "browser-automation",
    "captchano"
  ],
  "author": "DishIs Technologies LLC <support@captchano.com> (https://captchano.com)",
  "license": "MIT",
  "homepage": "https://captchano.com/agents/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DishantSinghDev2/captchano-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/DishantSinghDev2/captchano-mcp/issues",
    "email": "support@captchano.com"
  },
  "engines": {
    "node": ">=20.3"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
